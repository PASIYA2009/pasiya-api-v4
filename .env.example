# Vercel > Project > Settings > Environment Variables (same names)

# ---- required ----
FIREBASE_PROJECT_ID=pasiya-api
FIREBASE_WEB_API_KEY=AIzaSyCPZAmh7zUmU24aRtDvhGKXydh8DCDSaxk
# Firebase Console > Project settings > Service accounts > Generate new private key. Paste the WHOLE json on one line.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","...":"..."}
# Owner/admin e-mail(s). Comma separated list allowed. Gmail dots / +tags and capital letters are ignored.
# The admin must ALSO have a verified e-mail: log in with Google (always verified) or click the link in the verification mail.
ADMIN_EMAIL=eshandinujaya86@gmail.com

# ---- optional ----
SIGNUP_COINS=100
# Every API needs the user's PASIYA key (default). 1 = let anonymous callers use the FREE (0 coin) APIs too, per-IP limit.
ALLOW_KEYLESS=0
ANON_RATE_LIMIT_PER_MIN=30
PLATFORM_START=2026-10-30T00:00:00Z
RATE_LIMIT_PER_MIN=40
DAILY_COINS=5
# ---- AI: FREE keys (each takes ~2 minutes; add as many as you can, more keys = more reliable). WITHOUT any key the AI endpoints fail. ----
# Groq        https://console.groq.com/keys             (free, very fast)  -> GROQ_API_KEY
# Gemini      https://aistudio.google.com/apikey         (free)             -> GEMINI_API_KEY
# Cerebras    https://cloud.cerebras.ai                  (free)             -> CEREBRAS_API_KEY
# OpenRouter  https://openrouter.ai/keys                 (free ':free' models) -> OPENROUTER_API_KEY
# Mistral     https://console.mistral.ai                 (free tier)        -> MISTRAL_API_KEY
# GitHub Models: a GitHub token with 'models:read'        (free)             -> GITHUB_TOKEN
# Pollinations https://enter.pollinations.ai              (free key removes the '1 reply / 45 s' limit) -> POLLINATIONS_API_KEY
# Claude (real) = paid: ANTHROPIC_API_KEY (or OpenRouter credits). Without it /api/ai/claude answers with a free substitute (substituted:true).
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=
POLLINATIONS_API_KEY=
ANTHROPIC_API_KEY=
# Web search: free key from https://brave.com/search/api (optional; Bing/DuckDuckGo are used without it)
BRAVE_API_KEY=
# YouTube download fallback: a cobalt server you host (https://github.com/imputnet/cobalt) -> COBALT_API_URL, COBALT_API_KEY
COBALT_API_URL=
COBALT_API_KEY=
# AI (all optional: with none of these, AI uses a free keyless public service. Real keys are tried first and are more reliable).
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# Free keyless-style AI fallback: Cloudflare Workers AI over REST (free account + API token with "Workers AI" permission)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Movies: with no key the IMDb lookup is used. Trending needs this free key.
TMDB_API_KEY=
CATBOX_USERHASH=
# Optional separate yt-dlp downloader (original pasiya-scraper-api). Downloads work keyless without it; this makes them more reliable.
SCRAPER_URL=
SCRAPER_SHARED_SECRET=
